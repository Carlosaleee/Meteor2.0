{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "**/data/*.json"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/v1/cron/refresh",
      "schedule": "0 3 * * *"
    }
  ]
}
