# Meteor 2.0 - Backend Environment Variables (Production)
# Copy this to Railway/Render/Vercel > Settings > Environment Variables

# Server
PORT=3001
FRONTEND_ORIGIN=https://meteor2-0-frontend.vercel.app
NODE_ENV=production

# Gemini AI (required for oceanography summary)
GEMINI_API_KEY=SUA_CHAVE_AQUI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Fallback (only for Railway/Render - filesystem available)
FALLBACK_DIR=data
FALLBACK_MAX_AGE_HOURS=24

# Optional APIs (disabled when empty)
STORMGLASS_API_KEY=
INMET_API_TOKEN=
INMET_BASE_URL=https://apitempo.inmet.gov.br
