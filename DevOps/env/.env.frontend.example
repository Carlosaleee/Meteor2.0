# Meteor 2.0 - Frontend Environment Variables (Production)
# Nenhuma env var obrigatória: o proxy /api está em apps/frontend/vercel.json
# e o fallback de produção usa /api automaticamente.
# Se quiser sobrescrever, defina abaixo e faça Redeploy (NEXT_PUBLIC_* é
# embutida no bundle durante o build).

NEXT_PUBLIC_API_URL=/api
