# Backend
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# Gemini — v2.5 script (application.properties:14)
GEMINI_API_KEY=SUA_CHAVE_AQUI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Stormglass — optional; provider disabled when empty
STORMGLASS_API_KEY=

# INMET — optional token; base URL has a public default
INMET_API_TOKEN=
INMET_BASE_URL=https://apitempo.inmet.gov.br

# Database — SQLite file (sql em vez de postgre) — user/pass compat for future MySQL
DATABASE_URL=file:./data/meteor.db
DB_USER=root
DB_PASSWORD=123456

# GitHub MCP (.opencode/mcp/github-server.mjs)
GITHUB_TOKEN=
GITHUB_OWNER=Carlosaleee
GITHUB_REPO=Meteor2.0

# Frontend (public URL only — never put API secrets here)
NEXT_PUBLIC_API_URL=http://localhost:3001
