{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "regions": ["gru1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "../data/*.json"
    }
  },
  "crons": [
    {
      "path": "/v1/cron/refresh?scope=news",
      "schedule": "0 * * * *"
    },
    {
      "path": "/v1/cron/refresh",
      "schedule": "0 */6 * * *"
    }
  ]
}
